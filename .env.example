# ============================================================
# Payment Chaser — Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Supabase Configuration (Client & Server)
# ------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase public anonymous API key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------
# Development & Mock Mode Flag
# ------------------------------------------------------------
# Set to 'true' to use local browser mock storage during development
# Set to 'false' to enforce real Supabase database and authentication
NEXT_PUBLIC_USE_MOCK=false

# ------------------------------------------------------------
# Server-Only Configuration (DO NOT EXPOSE TO BROWSER)
# ------------------------------------------------------------
# Supabase Service Role Key (Server-side cron and webhook processing only)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Shared secret for authenticating automated cron triggers (/api/cron/send-reminders)
# CRON_SECRET=your-random-cron-secret-token-here

# Resend API key for outbound transactional emails (Phase 3+)
# RESEND_API_KEY=re_your_api_key_here

# WhatsApp Business Cloud API (Phase 3+)
# WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# Paddle Billing (Phase 4+)
# PADDLE_API_KEY=your-paddle-api-key-here
# PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_your_webhook_secret-here
